# PostgreSQL
POSTGRES_USER=scalistai
POSTGRES_PASSWORD=scalistai_dev
POSTGRES_DB=scalistai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# development | production — en production JWT_SECRET débil aborta el arranque
ENVIRONMENT=development
# Generá uno fuerte: openssl rand -hex 32  (≥32 chars, no uses el default)
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Brute-force login: intentos por IP / ventana en segundos (0 = off)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
STORAGE_DIR=/app/storage
CORS_ORIGINS=http://localhost:3000

# Redis (para colas async en sprints siguientes)
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here
FRONTEND_PORT=3000
